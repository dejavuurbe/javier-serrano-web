---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
import { identityGraphSchema, faqSchema } from '../core/schema';
import { localPath } from '../core/paths';

const book = site.featuredBook;
const previousWork = site.works.find((work) => !work.featured);
const bookMeta = [
  ['Género', book.genre, book.editorialState.genre],
  ['Año', book.year, book.editorialState.year],
  ['Páginas', book.pages, book.editorialState.pages],
  ['ISBN', book.isbn, book.editorialState.isbn],
  ['Edición', book.publisher, book.editorialState.publisher],
].filter(([, , state]) => state !== 'omitted');
const purchaseLinks = book.purchaseLinks.filter((item) => /^https?:\/\//.test(item.url));
---
<BaseLayout title={`${site.name} | ${site.role}`} description={site.description} schema={[identityGraphSchema(), faqSchema()]}>
  <section class="hero section section-screen compact" id="inicio">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Jujuy → González Catán</p>
        <h1>{site.name}</h1>
        <p class="lead">{site.tagline}</p>
        <div class="territory-axis" aria-label="Recorrido territorial">
          <span>origen</span>
          <span class="route" aria-hidden="true"></span>
          <span>camino</span>
          <span class="route" aria-hidden="true"></span>
          <span>pertenencia</span>
        </div>
        <div class="identity-words" aria-label="Ejes de identidad">
          <span>Terruño</span><span>Folklore</span><span>Memoria</span><span>Vida cotidiana</span>
        </div>
        <div class="actions">
          <a class="button" href="#obra">Conocer Migrante</a>
          <a class="button secondary" href="#territorio">Sobre Javier</a>
        </div>
      </div>

      <figure class="portrait-window media-item">
        <div class="window-label">Una mirada desde el territorio</div>
        <img class="portrait" src={localPath(site.author.photo)} alt={`Retrato de ${site.name}`} width="700" height="667" />
      </figure>
    </div>
  </section>

  <section class="section book-section" id="obra">
    <div class="container book-grid">
      <figure class="book-visual media-item">
        <div class="road-mark" aria-hidden="true"></div>
        <img class="cover" src={localPath(book.cover)} alt={`Portada de ${book.title}`} width="600" height="602" />
      </figure>

      <div class="book-copy">
        <p class="eyebrow">Obra más reciente</p>
        <h2>{book.title}</h2>
        {book.subtitle && <p class="book-motto">“{book.subtitle}”</p>}
        <p class="lead">{book.synopsis}</p>
        {bookMeta.length > 0 && <dl class="book-meta">{bookMeta.map(([label,value,state]) => <div><dt>{label}</dt><dd>{state === 'confirmed' && value ? value : <span class="pending-inline">Pendiente</span>}</dd></div>)}</dl>}
        {purchaseLinks.length > 0 && <div class="purchase">{purchaseLinks.map((item)=><a class="button" href={item.url} target="_blank" rel="noopener">{item.label}</a>)}</div>}
      </div>
    </div>
  </section>

  {previousWork && (
    <section class="section previous-section" id="ventana">
      <div class="container previous-grid">
        <div class="window-symbol" aria-hidden="true">
          <span></span>
        </div>
        <div>
          <p class="eyebrow">Obra anterior</p>
          <h2>{previousWork.title}</h2>
          <p class="lead">{previousWork.synopsis}</p>
          <p class="previous-note">Una segunda pieza del mismo recorrido: pueblo, paisaje, pertenencia y memoria.</p>
        </div>
      </div>
    </section>
  )}

  <section class="section territory-section" id="territorio">
    <div class="container territory-grid">
      <div>
        <p class="eyebrow">Territorio</p>
        <h2>Entre el lugar de origen y el lugar que se habita</h2>
      </div>
      <div>
        <p class="lead">{site.author.longBio}</p>
        {site.author.bioState === 'pending' && <p class="pending-note">Biografía pública definitiva: pendiente de aprobación del autor.</p>}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero{position:relative}
  .hero-grid{display:grid;gap:clamp(2.5rem,7vw,7rem);align-items:center}
  .hero-copy{position:relative;z-index:1}
  .hero h1{font-size:clamp(3.7rem,9vw,7.8rem);line-height:.88;max-width:7ch}
  .hero .lead{max-width:46ch;color:var(--color-text)}
  .territory-axis{display:flex;align-items:center;gap:.65rem;margin-top:1.4rem;max-width:620px;font-size:.72rem;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--color-muted)}
  .territory-axis .route{flex:1;min-width:42px;height:2px;background:linear-gradient(90deg,var(--identity-earth),var(--identity-ochre),var(--identity-sky))}
  .identity-words{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:1.15rem}
  .identity-words span{padding:.38rem .68rem;border:1px solid color-mix(in srgb,var(--identity-earth) 45%,var(--color-border));background:rgba(255,249,239,.58);font-size:.74rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
  .actions{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1.8rem}

  .portrait-window{position:relative;margin:0;padding:14px 14px 26px;background:#7e5a42;border:1px solid rgba(52,39,31,.25);box-shadow:var(--shadow);transform:rotate(1deg)}
  .portrait-window::before{content:"";position:absolute;inset:14px;border:1px solid rgba(255,248,235,.48);pointer-events:none}
  .portrait-window .portrait{width:100%;aspect-ratio:1.06/1;object-fit:cover;object-position:center 38%;border-radius:0;box-shadow:none}
  .window-label{position:absolute;left:28px;bottom:4px;color:#f8ead4;font-family:var(--font-display);font-size:.8rem;font-style:italic;letter-spacing:.04em}

  .book-grid{display:grid;gap:clamp(2.5rem,7vw,6rem);align-items:center}
  .book-visual{position:relative;margin:0;isolation:isolate}
  .book-visual::before{content:"";position:absolute;inset:-22px 12% -26px -18px;z-index:-2;background:linear-gradient(155deg,var(--identity-sky),var(--identity-earth) 58%,var(--identity-road));clip-path:polygon(0 5%,100% 0,92% 100%,7% 92%)}
  .book-visual::after{content:"";position:absolute;left:50%;bottom:-28px;width:34%;height:34%;z-index:-1;background:linear-gradient(180deg,rgba(246,232,214,.15),rgba(246,232,214,.65));clip-path:polygon(42% 0,58% 0,100% 100%,0 100%)}
  .cover{width:min(100%,430px);margin-inline:auto;border-radius:3px;box-shadow:0 24px 52px rgba(36,31,28,.28)}
  .book-copy h2{font-size:clamp(4rem,9vw,8rem);line-height:.84;color:var(--identity-earth);letter-spacing:-.045em}
  .book-motto{max-width:28ch;margin:.5rem 0 1.25rem;font-family:var(--font-display);font-size:clamp(1.3rem,2.4vw,1.8rem);font-style:italic;color:var(--identity-night)}
  .book-meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem 1.2rem;margin:1.4rem 0 0}
  .book-meta div{padding-top:.7rem;border-top:1px solid color-mix(in srgb,var(--identity-earth) 38%,var(--color-border))}
  .book-meta dt{font-size:.73rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--color-muted)}
  .book-meta dd{margin:.2rem 0 0;font-weight:600}
  .pending-inline{color:var(--color-muted)}
  .purchase{margin-top:1.5rem}

  .previous-grid{display:grid;gap:clamp(2rem,6vw,5rem);align-items:center}
  .window-symbol{min-height:280px;position:relative;background:linear-gradient(#869aa2 0 38%,#718069 38% 58%,#b39068 58%);border:20px solid #6b4c38;box-shadow:inset 0 0 0 2px rgba(255,255,255,.32),var(--shadow)}
  .window-symbol::before,.window-symbol::after{content:"";position:absolute;background:#6b4c38}
  .window-symbol::before{left:50%;top:0;bottom:0;width:14px;transform:translateX(-50%)}
  .window-symbol::after{top:50%;left:0;right:0;height:14px;transform:translateY(-50%)}
  .window-symbol span{position:absolute;left:50%;bottom:0;width:34%;height:47%;background:linear-gradient(180deg,rgba(240,225,198,.12),rgba(240,225,198,.62));clip-path:polygon(44% 0,56% 0,100% 100%,0 100%);transform:translateX(-50%)}
  .previous-grid h2{font-size:clamp(3rem,7vw,6.2rem);line-height:.88}
  .previous-note{max-width:48ch;margin-top:1.2rem;color:var(--identity-earth);font-family:var(--font-display);font-size:1.15rem;font-style:italic}

  .territory-grid{display:grid;gap:clamp(2.5rem,7vw,6rem);align-items:start}
  .territory-grid h2{max-width:12ch;font-size:clamp(2.8rem,6vw,5.4rem);line-height:.92}
  .pending-note{display:inline-flex;margin:.8rem 0 0;padding:.4rem .7rem;border:1px dashed var(--color-border);color:var(--color-muted);font-size:.84rem}

  @media(min-width:850px){
    .hero-grid{grid-template-columns:1.08fr .92fr}
    .book-grid{grid-template-columns:.92fr 1.08fr}
    .previous-grid{grid-template-columns:.78fr 1.22fr}
    .territory-grid{grid-template-columns:.82fr 1.18fr}
  }
  @media(max-width:849px){
    .portrait-window{max-width:520px;margin-inline:auto}
    .territory-axis{gap:.4rem}
    .identity-words span{font-size:.68rem}
    .book-copy h2{font-size:clamp(3.5rem,18vw,6rem)}
  }
</style>
